# Set default behavior to automatically normalize line endings
* text=auto

# Source code files
*.java text eol=lf diff=java
*.xml text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.json text eol=lf
*.js text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.svg text eol=lf
*.apk binary
*.keystore binary
*.jks binary
*.jar binary
